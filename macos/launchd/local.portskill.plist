<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.portskill.keepalive</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PORTSKILL_DAEMON__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>AbandonProcessGroup</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>2</integer>
  <key>WorkingDirectory</key>
  <string>__PORTSKILL_PACKAGE_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PORTSKILL_PACKAGE_ROOT</key>
    <string>__PORTSKILL_PACKAGE_ROOT__</string>
    <key>PORTSKILL_KEEPALIVE</key>
    <string>1</string>
    <key>PORTSKILL_NO_OPEN</key>
    <string>1</string>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/Portskill/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/Portskill/launchd.err.log</string>
</dict>
</plist>
